# Test-environment overrides, layered on top of .env by symfony/dotenv's
# standard .env -> .env.$APP_ENV cascade — no custom bootstrap needed.

# Separate from the dev DB (var/data.db) so running the test suite never
# touches data you're looking at in the browser. Wiped and re-migrated on
# every `composer test` run — see backend/composer.json.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"

# Symfony's built-in "swallow the email" transport — notifier/reminder tests
# don't need Mailpit running.
MAILER_DSN=null://null
