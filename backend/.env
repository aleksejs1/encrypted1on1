APP_ENV=dev
APP_DEBUG=1
# Dev-only placeholder. Real secret generation is a later phase (see plan roadmap).
APP_SECRET=dev-placeholder-secret-not-for-production

DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

# Where the frontend dev server runs, for printing activation links and building notification email links.
FRONTEND_URL=http://localhost:5173

# Dev: Mailpit's SMTP catcher (docker-compose.dev.yml), no auth. Prod: a real external SMTP DSN.
MAILER_DSN=smtp://mailpit:1025
MAILER_FROM=noreply@encrypted1on1.local

# invite | admin_only | domain
REGISTRATION_MODE=invite
# Empty = no restriction on which email domains can be invited/registered.
ALLOWED_EMAIL_DOMAIN=
