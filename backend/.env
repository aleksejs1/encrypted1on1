APP_ENV=dev
APP_DEBUG=1
# Dev-only placeholder. Real secret generation is a later phase (see plan roadmap).
APP_SECRET=dev-placeholder-secret-not-for-production

DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

# Where the frontend dev server runs, for printing activation links and building notification email links.
FRONTEND_URL=http://localhost:5173

# Dev: Mailpit's SMTP catcher (docker-compose.dev.yml), no auth. Prod: a real external SMTP DSN.
MAILER_DSN=smtp://mailpit:1025
MAILER_FROM=noreply@encrypted1on1.local

# REGISTRATION_MODE/ALLOWED_EMAIL_DOMAIN used to live here as global env vars. They're
# now per-Company columns instead (private/cloud-service-plan.md, not tracked in git,
# Phase A) — the migration that added the companies table seeds the one company every
# self-hosted deployment has with registrationMode=invite/allowedEmailDomain='', the same
# defaults these env vars used to carry. Changing them now means updating that Company
# row (e.g. via `bin/console dbal:run-sql`), not editing this file.

# Phase B of private/cloud-service-plan.md (not tracked in git): whether the public
# "create your company" self-service signup (CompanyController) is reachable at all.
# Off by default — self-hosted deployments never expose this; a self-hosted operator
# always bootstraps their one company via bin/console app:create-activation-link
# instead. Only ever turn this on for a real multi-tenant cloud deployment.
CLOUD_MODE=0

# Seat count a brand-new self-service company starts on (CompanyController, Phase B/D of
# private/cloud-service-plan.md, not tracked in git) — a placeholder, not a decided
# pricing tier (see the plan's own "not an engineering decision" note). Irrelevant unless
# CLOUD_MODE=1. Companies that predate this (the single self-hosted default company) stay
# unlimited regardless of this value — it only applies to companies created from here on.
DEFAULT_SEAT_LIMIT=5

# Phase D of private/cloud-service-plan.md (not tracked in git): billing scaffolding —
# empty by default, which StripeBillingProvider treats as "not configured" and refuses
# to create a checkout session for (503, errors.billing_not_configured). Never set these
# for a self-hosted deployment. STRIPE_WEBHOOK_SECRET/STRIPE_PRICE_ID come from the
# Stripe dashboard once a real account/product exists; this scaffolding has never been
# run against a live Stripe account — see CLAUDE.md's own Phase D entry for exactly
# what is and isn't verified here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Backend error tracking (config/packages/sentry.php). Empty by default — an empty DSN
# is treated by the Sentry SDK the same as "disabled", not an error, so self-hosted
# deployments send nothing anywhere unless an operator opts in. Only the encrypted1on1
# Cloud deployment sets a real DSN today. Frontend errors aren't reported anywhere yet.
SENTRY_DSN=

# Rate limits (config/packages/rate_limiter.php) — each named limiter's request count
# and sliding-window interval, overridable per deployment so a production SMTP/auth
# setup with more headroom than these defaults isn't stuck with them (see
# docs/deployment.md's "Rate limits" table for what each one actually guards). The
# values below match what was hardcoded before this became configurable — a bare
# checkout with none of these set behaves exactly as before. INTERVAL values are
# Symfony rate-limiter interval strings (e.g. "1 hour", "1 minute", "30 seconds").
LOGIN_RATE_LIMIT=20
LOGIN_RATE_LIMIT_INTERVAL="1 minute"
INVITE_RATE_LIMIT=10
INVITE_RATE_LIMIT_INTERVAL="1 hour"
ACTIVATION_COMPLETE_RATE_LIMIT=10
ACTIVATION_COMPLETE_RATE_LIMIT_INTERVAL="1 minute"
PASSWORD_RESET_REQUEST_RATE_LIMIT=5
PASSWORD_RESET_REQUEST_RATE_LIMIT_INTERVAL="1 hour"
PASSWORD_RESET_COMPLETE_RATE_LIMIT=10
PASSWORD_RESET_COMPLETE_RATE_LIMIT_INTERVAL="1 minute"
CHANGE_PASSWORD_RATE_LIMIT=5
CHANGE_PASSWORD_RATE_LIMIT_INTERVAL="1 hour"
DELETE_ACCOUNT_RATE_LIMIT=5
DELETE_ACCOUNT_RATE_LIMIT_INTERVAL="1 hour"
SIGNUP_RATE_LIMIT=5
SIGNUP_RATE_LIMIT_INTERVAL="1 hour"
CREATE_COMPANY_RATE_LIMIT=5
CREATE_COMPANY_RATE_LIMIT_INTERVAL="1 hour"
