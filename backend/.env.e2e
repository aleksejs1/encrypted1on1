# E2E-environment overrides, layered on top of .env by symfony/dotenv's standard
# .env -> .env.$APP_ENV cascade. Deliberately its own environment, not a reuse of
# .env.test's — config/packages/test/framework.php swaps in mock_file session
# storage, built for PHPUnit's in-process KernelBrowser client, not a real running
# server serving two genuinely independent real browser sessions over real HTTP
# (exactly what the dual-actor Playwright suite needs). No config/packages/e2e/
# override exists at all, so this gets Symfony's real, default, file-backed native
# session storage — the same kind prod uses.

# Separate from both the dev DB (var/data.db) and the PHPUnit test DB (var/test.db)
# — wiped and re-migrated on every `make e2e-up` run (see Makefile), and lives in
# its own named Docker volume (docker-compose.e2e.yml), never touching either.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/e2e.db"

# Symfony's built-in "swallow the email" transport — e2e provisions accounts via
# the real app:create-activation-link CLI command directly, same as PHPUnit's own
# ApiTestCase::activateUser(), and doesn't check email content today.
MAILER_DSN=null://null

# The e2e-dedicated frontend dev server's own port (vite.config.e2e.ts), distinct
# from dev's 5173 so both stacks can run side by side without colliding.
FRONTEND_URL=http://localhost:5174

# The full Playwright suite provisions real accounts via app:create-activation-link
# and completes each one through the real UI — 21 such completions across the
# current suite (frontend/e2e/*.spec.ts), all from the one IP the runner uses,
# comfortably over the production-sized default (10/minute — backend/.env,
# config/packages/rate_limiter.php). Without this override, whichever test's
# activation happens to be the 11th+ in a rolling minute gets a real 429, and the
# frontend never navigates past /activate/{token} since the request itself failed
# — looked like environmental flakiness at first (a plain page.waitForURL timeout
# with no obvious cause), confirmed as this instead by inspecting the failing
# request's own response in a CI trace. Same override mechanism
# rate_limiter.php's own header comment already documents for exactly this class
# of "the production-sized default doesn't fit this environment's real
# throughput" problem — see docs/decisions/2026-09-12-anketa-live-updates.md.
ACTIVATION_COMPLETE_RATE_LIMIT=100
