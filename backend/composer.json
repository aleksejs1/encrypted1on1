{
    "name": "encrypted1on1/backend",
    "description": "Backend for encrypted1on1 — a self-hosted, end-to-end encrypted 1:1 meeting platform.",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.4",
        "api-platform/core": "^4.3",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6",
        "symfony/console": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/framework-bundle": "^7.2",
        "symfony/runtime": "^7.2",
        "symfony/security-csrf": "^8.1",
        "symfony/string": "^7.2",
        "symfony/uid": "^8.1"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "extra": {
        "runtime": {
            "class": "Symfony\\Component\\Runtime\\SymfonyRuntime"
        }
    }
}
