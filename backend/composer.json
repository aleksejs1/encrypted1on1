{
    "name": "encrypted1on1/backend",
    "description": "Backend for encrypted1on1 — a self-hosted, end-to-end encrypted 1:1 meeting platform.",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.4",
        "symfony/framework-bundle": "^7.2",
        "symfony/runtime": "^7.2",
        "symfony/string": "^7.2"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "extra": {
        "runtime": {
            "class": "Symfony\\Component\\Runtime\\SymfonyRuntime"
        }
    }
}
