# Prod Caddyfile — see the Phase 7d plan for why the base FrankenPHP image's
# default (routes everything through php_server, falling back to index.php)
# doesn't work here: SPA client-side routes like /anketas/abc-123 aren't real
# Symfony routes, so that fallback would 404 them instead of serving the SPA.
{
	skip_install_trust
	frankenphp
}

{$SERVER_NAME:localhost} {
	root * /app/public
	encode zstd br gzip

	# Browser-side backstop matching this app's own trust model: if the server
	# or its build pipeline is ever compromised, this is what stops it from
	# silently swapping the crypto code that runs in the browser. Applies
	# uniformly to both the API (pure JSON, harmless) and the static SPA.
	# 'wasm-unsafe-eval' is required, not optional — libsodium-wrappers-sumo's
	# crypto core is real WebAssembly (confirmed against the actual built
	# bundle, not assumed), and WebAssembly.instantiate() is blocked by CSP
	# without it. No 'unsafe-eval', no 'unsafe-inline' — confirmed via the
	# same real-bundle check that neither is needed.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; frame-src 'none'; worker-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
	}

	# Only the real API surface goes to PHP.
	@backend path /api/* /health
	handle @backend {
		php_server
	}

	# Everything else: serve the literal static file if it exists (built SPA
	# assets), otherwise fall back to index.html so the SPA's own client-side
	# router (router.svelte.ts) can handle the route.
	handle {
		try_files {path} /index.html
		file_server
	}
}
