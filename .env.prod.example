# Copy this file to .env.prod and fill in real values, then run either:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# or, if this host already has another reverse proxy (e.g. nginx) owning
# ports 80/443 — see README.md's "Production, behind an existing reverse
# proxy" section:
#   docker compose -f docker-compose.prod.reverse-proxy.yml --env-file .env.prod up -d --build
#
# .env.prod is gitignored — never commit real secrets. This is a separate
# file from backend/.env (Symfony's own dev/test config, already committed
# with functional placeholder values for local development) — deliberately
# not relying on docker compose's implicit bare-.env auto-load, to avoid any
# ambiguity between the two.

# Random, unique to this deployment. Generate with: openssl rand -hex 32
# Never reuse the dev placeholder from backend/.env.
APP_SECRET=

# The real public domain this instance is reachable at (DNS already pointing
# here). With docker-compose.prod.yml: ports 80/443 must be open — Caddy uses
# this to provision an automatic HTTPS certificate via Let's Encrypt. With
# docker-compose.prod.reverse-proxy.yml: your existing reverse proxy handles
# TLS/DNS instead, this is just used for routing/links. Do not set this to
# localhost or an IP.
SERVER_NAME=1on1.example.com

# Same domain as SERVER_NAME, with scheme — used to build links in emails.
FRONTEND_URL=https://1on1.example.com

# A real SMTP DSN (see Symfony Mailer's DSN format). The dev/test
# smtp://mailpit:1025 placeholder will not work here — there is no Mailpit
# in the prod image.
MAILER_DSN=smtp://user:pass@smtp.example.com:587
MAILER_FROM=noreply@1on1.example.com

# invite | admin_only | domain (domain = open self-registration restricted to
# ALLOWED_EMAIL_DOMAIN below, gated by double opt-in).
REGISTRATION_MODE=invite
# Empty = no restriction on which email domains can be invited/registered.
ALLOWED_EMAIL_DOMAIN=

# interactive (default, 64MiB) | moderate (256MiB) | sensitive (1GiB) — the
# argon2id cost profile the browser uses to derive login/master keys from a
# user's password. Baked into the static frontend bundle at *build* time
# (docker/prod/app.Dockerfile's ARGON2ID_PROFILE build arg), not read at
# runtime — `--build` is required for a change here to take effect.
#
# WARNING: pick this once, before any real user registers, and never change
# it on a running instance afterwards. Both the login auth key and the
# master key that unwraps a user's stored private key are derived from this
# profile — changing it recomputes different keys on every subsequent
# login, which locks every existing account out irrecoverably (wrong auth
# key, and the stored encrypted private key no longer unwraps even after a
# successful login). This is not something a password reset fixes cleanly
# either, since the account's whole keypair would need regenerating anyway.
ARGON2ID_PROFILE=interactive

# --- Only needed with docker-compose.prod.reverse-proxy.yml ---

# Where Caddy listens for your reverse proxy to connect to — bind to
# localhost, not 0.0.0.0, since this is an internal implementation detail,
# not meant to be reachable directly from outside the host. Must match your
# reverse proxy's upstream/proxy_pass target.
APP_INTERNAL_BIND=127.0.0.1:8090

# Who Symfony (TRUSTED_PROXIES) and Caddy (CADDY_TRUSTED_PROXIES, same IPs,
# space- not comma-separated — Caddyfile syntax) trust the X-Forwarded-*
# headers of. Both default to loopback, correct if your reverse proxy runs
# on this same host — widen if it's elsewhere (a different container, a
# separate host). Leave unset entirely (or use docker-compose.prod.yml
# instead) if you don't have a reverse proxy in front of this app.
TRUSTED_PROXIES=127.0.0.1,::1
CADDY_TRUSTED_PROXIES=127.0.0.1 ::1
