# Copy this file to .env.prod and fill in real values, then run either:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# or, if this host already has another reverse proxy (e.g. nginx) owning
# ports 80/443 — see README.md's "Production, behind an existing reverse
# proxy" section:
#   docker compose -f docker-compose.prod.reverse-proxy.yml --env-file .env.prod up -d --build
#
# .env.prod is gitignored — never commit real secrets. This is a separate
# file from backend/.env (Symfony's own dev/test config, already committed
# with functional placeholder values for local development) — deliberately
# not relying on docker compose's implicit bare-.env auto-load, to avoid any
# ambiguity between the two.

# Random, unique to this deployment. Generate with: openssl rand -hex 32
# Never reuse the dev placeholder from backend/.env.
APP_SECRET=

# The real public domain this instance is reachable at (DNS already pointing
# here). With docker-compose.prod.yml: ports 80/443 must be open — Caddy uses
# this to provision an automatic HTTPS certificate via Let's Encrypt. With
# docker-compose.prod.reverse-proxy.yml: your existing reverse proxy handles
# TLS/DNS instead, this is just used for routing/links. Do not set this to
# localhost or an IP.
SERVER_NAME=1on1.example.com

# Same domain as SERVER_NAME, with scheme — used to build links in emails.
FRONTEND_URL=https://1on1.example.com

# A real SMTP DSN (see Symfony Mailer's DSN format). The dev/test
# smtp://mailpit:1025 placeholder will not work here — there is no Mailpit
# in the prod image.
MAILER_DSN=smtp://user:pass@smtp.example.com:587
MAILER_FROM=noreply@1on1.example.com

# REGISTRATION_MODE/ALLOWED_EMAIL_DOMAIN used to be set here as env vars. They're now
# per-Company database columns instead (private/cloud-service-plan.md, not tracked in
# git, Phase A) — every deployment gets exactly one seeded Company row
# (registrationMode=invite/allowedEmailDomain='' by default, the same values these env
# vars used to default to). Changing them means updating that row directly (e.g. via
# `docker compose exec app php bin/console dbal:run-sql "UPDATE companies SET ..."`),
# not editing this file — a value set here now has no effect.

# interactive (default, 64MiB) | moderate (256MiB) | sensitive (1GiB) — the
# argon2id cost profile the browser uses to derive login/master keys from a
# user's password. Baked into the static frontend bundle at *build* time
# (docker/prod/app.Dockerfile's ARGON2ID_PROFILE build arg), not read at
# runtime — `--build` is required for a change here to take effect.
#
# WARNING: pick this once, before any real user registers, and never change
# it on a running instance afterwards. Both the login auth key and the
# master key that unwraps a user's stored private key are derived from this
# profile — changing it recomputes different keys on every subsequent
# login, which locks every existing account out irrecoverably (wrong auth
# key, and the stored encrypted private key no longer unwraps even after a
# successful login). This is not something a password reset fixes cleanly
# either, since the account's whole keypair would need regenerating anyway.
ARGON2ID_PROFILE=interactive

# Your own company's privacy policy/legal notice URL, shown as a link in the
# app's footer — legal responsibility for how data is handled sits with
# whoever deploys this tool, not the software itself, but the interface
# needs somewhere to point people. Baked into the static frontend bundle at
# *build* time, same as ARGON2ID_PROFILE above — `--build` needed for a
# change to take effect. Empty (default) means no footer link at all.
PRIVACY_POLICY_URL=

# Set to "true" to show a "Try the live demo" button on the login page,
# which logs a visitor straight into a fixed, publicly-known demo account
# (see docs/deployment.md's "Demo mode" section) — no signup, no real data
# at risk. Baked into the static frontend bundle at *build* time, same as
# ARGON2ID_PROFILE/PRIVACY_POLICY_URL above — `--build` needed for a change
# to take effect. Only meaningful once you've also set up the hourly
# `app:reset-demo-data` cron job described in docs/deployment.md; without
# it, the demo account still works but never resets after visitors edit it.
DEMO_MODE=false

# Set to "true" to show the app version (and commit hash, if available) in
# the footer — handy for confirming what's actually deployed. Baked into the
# static frontend bundle at *build* time, same as the flags above —
# `--build` needed for a change to take effect. Off by default: not every
# operator wants build/version details visible to end users. The commit
# hash itself (GIT_SHA) doesn't need setting here — docker/prod/deploy.sh
# computes it automatically from the checked-out git commit.
SHOW_VERSION=false

# Timezone for container-level tools (the `date` command, log timestamps if
# you inspect them directly) — display/log-only. PHP's own date handling
# (including the daily reminder job's "is the meeting tomorrow" check)
# already hardcodes UTC explicitly and never reads this, so changing it
# doesn't affect when reminders fire.
TZ=UTC

# Backend error tracking (Sentry). Leave empty (default) to send nothing anywhere — an
# empty DSN is treated by the Sentry SDK the same as "disabled", not an error. Only set
# this if you're running your own Sentry project (self-hosted or sentry.io) and want
# this instance's backend exceptions reported there. Frontend errors aren't reported
# anywhere yet, regardless of this setting.
SENTRY_DSN=

# Rate limits (config/packages/rate_limiter.php) — optional overrides, e.g. if your
# SMTP provider has more send headroom than the default 10 invites/hour. Leave unset
# to keep the defaults shown below (see docs/deployment.md's "Rate limits" table for
# what each one guards). INTERVAL values are Symfony rate-limiter interval strings
# (e.g. "1 hour", "1 minute", "30 seconds").
LOGIN_RATE_LIMIT=20
LOGIN_RATE_LIMIT_INTERVAL="1 minute"
INVITE_RATE_LIMIT=10
INVITE_RATE_LIMIT_INTERVAL="1 hour"
ACTIVATION_COMPLETE_RATE_LIMIT=10
ACTIVATION_COMPLETE_RATE_LIMIT_INTERVAL="1 minute"
PASSWORD_RESET_REQUEST_RATE_LIMIT=5
PASSWORD_RESET_REQUEST_RATE_LIMIT_INTERVAL="1 hour"
PASSWORD_RESET_COMPLETE_RATE_LIMIT=10
PASSWORD_RESET_COMPLETE_RATE_LIMIT_INTERVAL="1 minute"
CHANGE_PASSWORD_RATE_LIMIT=5
CHANGE_PASSWORD_RATE_LIMIT_INTERVAL="1 hour"
DELETE_ACCOUNT_RATE_LIMIT=5
DELETE_ACCOUNT_RATE_LIMIT_INTERVAL="1 hour"
SIGNUP_RATE_LIMIT=5
SIGNUP_RATE_LIMIT_INTERVAL="1 hour"
CREATE_COMPANY_RATE_LIMIT=5
CREATE_COMPANY_RATE_LIMIT_INTERVAL="1 hour"

# --- Only needed with docker-compose.prod.reverse-proxy.yml ---

# Where Caddy listens for your reverse proxy to connect to — bind to
# localhost, not 0.0.0.0, since this is an internal implementation detail,
# not meant to be reachable directly from outside the host. Must match your
# reverse proxy's upstream/proxy_pass target.
APP_INTERNAL_BIND=127.0.0.1:8090

# Who Symfony (TRUSTED_PROXIES) and Caddy (CADDY_TRUSTED_PROXIES, same IPs,
# space- not comma-separated — Caddyfile syntax) trust the X-Forwarded-*
# headers of. Both default to loopback, correct if your reverse proxy runs
# on this same host — widen if it's elsewhere (a different container, a
# separate host). Leave unset entirely (or use docker-compose.prod.yml
# instead) if you don't have a reverse proxy in front of this app.
TRUSTED_PROXIES=127.0.0.1,::1
CADDY_TRUSTED_PROXIES=127.0.0.1 ::1
