# Copy this file to .env.cloud and fill in real values, then run either:
#   docker compose -f docker-compose.cloud.yml --env-file .env.cloud --profile bundled-db up -d --build
# or, if this host already has another reverse proxy (e.g. nginx, or another Caddy
# fronting other projects — a landing page, a self-hosted/demo instance) owning ports
# 80/443 — see the "Cloud deployment" section of docs/deployment.md:
#   docker compose -f docker-compose.cloud.reverse-proxy.yml --env-file .env.cloud --profile bundled-db up -d --build
# (drop --profile bundled-db either way if DATABASE_URL points at your own managed
# MySQL instead of the compose-bundled one)
#
# .env.cloud is gitignored — never commit real secrets. Separate from backend/.env
# (Symfony's own dev/test config) and from .env.prod (the self-hosted, single-company
# deployment mode) — this file is specifically for private/cloud-service-plan.md's
# multi-tenant cloud offering (not tracked in git), still Phase A-D scaffolding as of
# this writing, not a fully productionized SaaS. Read CLAUDE.md's own Phase D entry
# before running this for real: the Stripe checkout flow specifically has never been
# verified against a live Stripe account.

# Random, unique to this deployment. Generate with: openssl rand -hex 32
APP_SECRET=

# mysql://user:pass@host:3306/dbname?serverVersion=8.4.0 — MUST be MySQL, not SQLite
# (docker-compose.cloud.yml hardcodes CLOUD_MODE=1; see ADR 3, docs/adr/0003-sqlite-default-database.md,
# for why SQLite's concurrency model isn't validated for many companies sharing one
# database). Point this at the compose-bundled `mysql` service (see MYSQL_* below) or
# your own managed MySQL instance. After first start, run the MySQL-specific migration
# — NOT the default one:
#   docker compose -f docker-compose.cloud.yml exec app php bin/console doctrine:migrations:migrate --configuration=migrations-mysql.php --no-interaction
DATABASE_URL=mysql://encrypted1on1:PASSWORD@mysql:3306/encrypted1on1?serverVersion=8.4.0

# Only used if you start the `bundled-db` Compose profile (the self-contained MySQL
# service in docker-compose.cloud.yml) — irrelevant if DATABASE_URL above points at
# your own external managed MySQL instead. MYSQL_USER/MYSQL_PASSWORD must match the
# credentials embedded in DATABASE_URL above.
MYSQL_DATABASE=encrypted1on1
MYSQL_USER=encrypted1on1
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# The real public domain this instance is reachable at (DNS already pointing here).
# With docker-compose.cloud.yml: ports 80/443 must be open — Caddy uses this to
# provision an automatic HTTPS certificate via Let's Encrypt. With
# docker-compose.cloud.reverse-proxy.yml: your existing reverse proxy handles
# TLS/DNS instead, this is just used for routing/links. Do not set this to
# localhost or an IP.
SERVER_NAME=cloud.example.com

# Same domain as SERVER_NAME, with scheme — used to build links in emails and the
# Stripe checkout success/cancel redirect URLs.
FRONTEND_URL=https://cloud.example.com

# A real SMTP DSN (see Symfony Mailer's DSN format).
MAILER_DSN=smtp://user:pass@smtp.example.com:587
MAILER_FROM=noreply@example.com

# Seat count a brand-new self-service company starts on — a placeholder, not a decided
# pricing tier (see private/cloud-service-plan.md's own "not an engineering decision"
# note). Companies that predate this stay unlimited regardless of this value.
DEFAULT_SEAT_LIMIT=5

# Stripe billing (Phase D, private/cloud-service-plan.md, not tracked in git) — leave
# all three empty to run without checkout capability (seat limits and suspension still
# work; a platform admin can suspend a company manually via
# PUT /api/platform-admin/companies/{id}/suspended in the meantime). See
# StripeBillingProvider's own docblock: createCheckoutSession() makes a real network
# call to Stripe's API and has never been exercised against a live account — verify it
# for real yourself before relying on it. STRIPE_WEBHOOK_SECRET/STRIPE_PRICE_ID come
# from your Stripe dashboard once a real account/product exists.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# interactive (default, 64MiB) | moderate (256MiB) | sensitive (1GiB) — see
# .env.prod.example's own extensive warning: pick this once, before any real user
# registers, and never change it on a running instance afterwards.
ARGON2ID_PROFILE=interactive

# Your own company's privacy policy/legal notice URL, shown in the app's footer. Legal
# responsibility for how data is handled sits with whoever operates this cloud service,
# not the software itself — see private/cloud-service-plan.md's own note that a real
# Terms of Service and Data Processing Agreement are a precondition to charging anyone
# real money, not an engineering task this file can complete on its own.
PRIVACY_POLICY_URL=

# Set to "true" to show the app version (and commit hash, if available) in the footer
# — see .env.prod.example's own note. Off by default. The commit hash itself (GIT_SHA)
# doesn't need setting here either — docker/prod/deploy.sh computes it automatically
# for this topology too (PROD_COMPOSE_FILE=docker-compose.cloud.yml).
SHOW_VERSION=false

# Timezone for container-level tools — display/log-only, see .env.prod.example.
TZ=UTC

# Backend error tracking (Sentry) — set this for the cloud deployment so backend
# exceptions actually get reported somewhere; leave empty to send nothing (the Sentry
# SDK treats an empty DSN as "disabled", not an error). Sentry is already disclosed as
# a sub-processor in the landing site's Privacy Policy, covering exactly this: backend
# error reports for the Cloud deployment. Frontend errors aren't reported anywhere
# yet — if that's ever added, the Privacy Policy needs a further update to cover it.
SENTRY_DSN=

# --- Only needed with docker-compose.cloud.reverse-proxy.yml ---

# Where Caddy listens for your reverse proxy to connect to — bind to loopback, not
# 0.0.0.0, and pick a port not already used by another project's own APP_INTERNAL_BIND
# on this same host (e.g. a self-hosted/demo instance's own reverse-proxy setup).
# Must match your reverse proxy's upstream/proxy_pass target.
APP_INTERNAL_BIND=127.0.0.1:8091

# Who Symfony (TRUSTED_PROXIES) and Caddy (CADDY_TRUSTED_PROXIES, same IPs, different
# syntax — space- not comma-separated) trust the X-Forwarded-* headers of. Both default
# to loopback, correct if your reverse proxy runs on the same host — widen these (or
# clear TRUSTED_PROXIES entirely, matching docker-compose.cloud.yml's own default) if
# you don't have a reverse proxy in front of this instance.
TRUSTED_PROXIES=127.0.0.1,::1
CADDY_TRUSTED_PROXIES=127.0.0.1 ::1
