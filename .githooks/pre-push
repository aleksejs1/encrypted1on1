#!/bin/sh
# The one "heavy" check kept in a hook (typecheck) — everything else (tests,
# coverage, e2e) stays in CI and in `make test`/`make coverage`. Scoped to
# what actually changed relative to the push target, not the whole repo, so
# it stays fast. See README.md's "Git hooks" section.
set -u

if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
  range='@{u}...HEAD'
elif git show-ref --verify --quiet refs/remotes/origin/main; then
  range='origin/main...HEAD'
else
  range=''
fi

if [ -n "$range" ]; then
  changed=$(git diff --name-only "$range")
else
  # No upstream and no origin/main to diff against (e.g. very first push of a
  # fresh clone) — fall back to treating everything as touched rather than
  # silently checking nothing.
  changed=$(git ls-files)
fi

status=0

if printf '%s\n' "$changed" | grep -q '^backend/'; then
  if docker compose -f docker-compose.dev.yml ps -q backend 2>/dev/null | grep -q .; then
    echo "pre-push: backend changed — running composer schema-validate/stan..."
    docker compose -f docker-compose.dev.yml exec -T backend composer schema-validate || status=1
    docker compose -f docker-compose.dev.yml exec -T backend composer stan || status=1
  else
    echo "pre-push: WARNING — backend changed but the dev stack isn't running ('make up'); skipping composer schema-validate/stan. CI still gates this." >&2
  fi
fi

if printf '%s\n' "$changed" | grep -q '^frontend/'; then
  if [ -d frontend/node_modules ]; then
    echo "pre-push: frontend changed — running npm run check..."
    ( cd frontend && npm run check ) || status=1
  else
    echo "pre-push: WARNING — frontend changed but frontend/node_modules is missing ('npm install' in frontend/); skipping npm run check. CI still gates this." >&2
  fi
fi

# Manifest/lockfile drift: `npm ci`/`composer install` fail (or, for composer,
# warn) if the lockfile doesn't actually match the manifest — an incremental
# `npm install <pkg>` on an already-installed tree can silently leave the
# lockfile missing entries (hit for real: adding knip/playwright left
# frontend/package-lock.json missing ~28 optional-platform entries, which
# passed a plain `npm install` locally but failed CI's `npm ci` outright).
# Only `npm ci` actually catches this — `npm install` never refuses to run
# against a stale lockfile, it just quietly rewrites it.
if printf '%s\n' "$changed" | grep -qE '^(package(-lock)?\.json)$'; then
  echo "pre-push: root package.json/package-lock.json changed — running npm ci..."
  npm ci || status=1
fi

if printf '%s\n' "$changed" | grep -qE '^frontend/package(-lock)?\.json$'; then
  echo "pre-push: frontend/package.json or package-lock.json changed — running npm ci..."
  ( cd frontend && npm ci ) || status=1
fi

if printf '%s\n' "$changed" | grep -qE '^backend/composer\.(json|lock)$'; then
  if docker compose -f docker-compose.dev.yml ps -q backend 2>/dev/null | grep -q .; then
    echo "pre-push: backend composer.json/composer.lock changed — running composer validate..."
    docker compose -f docker-compose.dev.yml exec -T backend composer validate --no-check-all || status=1
  else
    echo "pre-push: WARNING — composer.json/lock changed but the dev stack isn't running ('make up'); skipping composer validate. CI still gates this." >&2
  fi
fi

exit "$status"
