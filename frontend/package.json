{
  "name": "encrypted1on1-frontend",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --config vite.config.e2e.ts",
    "build": "vite build && node scripts/inject-sri.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --cache",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --check \"{src,e2e}/**/*.{ts,svelte}\" \"*.ts\" \"*.js\"",
    "format:fix": "prettier --write \"{src,e2e}/**/*.{ts,svelte}\" \"*.ts\" \"*.js\"",
    "knip": "knip"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.9.1",
    "eslint-plugin-svelte": "^3.23.0",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "libsodium-wrappers-sumo": "^0.8.4",
    "svelte-i18n": "^4.0.1"
  }
}
